{
  "$schema": "https://sub0.app/schema/project.json",
  "name": "koraflow",
  "description": "School procurement approval API and immutable activity trail",
  "database": {
    "provider": "postgresql",
    "models": [
      {
        "name": "requests",
        "fields": {
          "id": { "type": "UUID", "primary": true, "generated": true },
          "title": { "type": "STRING", "required": true, "max_length": 180 },
          "requester": { "type": "STRING", "required": true, "max_length": 120 },
          "amount": { "type": "DECIMAL", "required": true, "min": 1 },
          "category": { "type": "STRING", "required": true },
          "status": { "type": "STRING", "default": "Pending" },
          "current_step": { "type": "INTEGER", "default": 1 },
          "created_at": { "type": "TIMESTAMP", "default": "NOW" },
          "updated_at": { "type": "TIMESTAMP", "default": "NOW" }
        },
        "indexes": ["status", "created_at"]
      },
      {
        "name": "activity",
        "fields": {
          "id": { "type": "UUID", "primary": true, "generated": true },
          "request_id": { "type": "UUID", "required": true, "references": "requests.id" },
          "actor": { "type": "STRING", "required": true },
          "action": { "type": "STRING", "required": true },
          "created_at": { "type": "TIMESTAMP", "default": "NOW" }
        },
        "indexes": ["request_id", "created_at"]
      }
    ]
  },
  "resources": [
    {
      "resource": "requests",
      "method": "GET",
      "actionables": [{ "mode": "QUERY", "sql_query": { "query": "SELECT * FROM requests ORDER BY created_at DESC" } }]
    },
    {
      "resource": "requests",
      "method": "POST",
      "actionables": [
        {
          "mode": "MUTATION",
          "payload_validation": [
            { "field": { "title": { "type": "STRING" } }, "min_length": 3, "max_length": 180 },
            { "field": { "requester": { "type": "STRING" } }, "min_length": 2, "max_length": 120 },
            { "field": { "amount": { "type": "NUMBER" } }, "min": 1 }
          ],
          "sql_query": {
            "query": "INSERT INTO requests (title, requester, amount, category, status, current_step) VALUES ($1, $2, $3, $4, 'Pending', 1) RETURNING *",
            "parameters": ["title", "requester", "amount", "category"]
          }
        }
      ]
    },
    {
      "resource": "requests/:id/approve",
      "method": "POST",
      "actionables": [
        {
          "mode": "MUTATION",
          "transaction": true,
          "sql_query": {
            "query": "UPDATE requests SET status = 'Approved', current_step = 3, updated_at = NOW() WHERE id = $1 RETURNING *",
            "parameters": ["id"]
          }
        },
        {
          "mode": "MUTATION",
          "sql_query": {
            "query": "INSERT INTO activity (request_id, actor, action) VALUES ($1, $2, 'approved') RETURNING *",
            "parameters": ["id", "actor"]
          }
        }
      ]
    },
    {
      "resource": "activity",
      "method": "GET",
      "actionables": [{ "mode": "QUERY", "sql_query": { "query": "SELECT * FROM activity ORDER BY created_at DESC LIMIT 30" } }]
    }
  ]
}

